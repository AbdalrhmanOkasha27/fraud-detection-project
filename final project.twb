            <column caption='Lower Bound' datatype='real' default-format='p0.00%' name='[Calculation_1627573250981904]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MAX(0, [Calculation_1627573250523149] - [Calculation_1627573250670606])' />
