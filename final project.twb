      <table>
        <view>
          <datasources>
            <datasource caption='Fact_Transactions+' name='federated.1mctkil1o0nn8q1gwws6q0vcfvh3' />
          </datasources>
          <datasource-dependencies datasource='federated.1mctkil1o0nn8q1gwws6q0vcfvh3'>
            <column caption='Total Transactions' datatype='integer' name='[Calculation_1627573243392000]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT([Customer_ID])' />
            </column>
            <column caption='Total Transaction Volume' datatype='real' default-format='*₹ #,##,##0;₹ -#,##,##0' name='[Calculation_1627573244006401]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Transaction_Amount])' />
            </column>
            <column caption='Total Fraud Count' datatype='integer' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1627573246181379]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Is_Fraud] = 1 THEN 1 ELSE 0 END)' />
            </column>
            <column caption='Fraud Rate %' datatype='real' default-format='p0.00%' name='[Calculation_1627573247025157]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1627573246181379] / [Calculation_1627573243392000]' />
            </column>
            <column caption='Fraud Exposure' datatype='real' default-format='*₹ #,##,##0;₹ -#,##,##0' name='[Calculation_1627573247328262]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Is_Fraud] = 1 THEN [Transaction_Amount] ELSE 0 END)' />
            </column>
            <column caption='Baseline Fraud Rate' datatype='real' default-format='p0.00%' name='[Calculation_1627573249499145]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED : [Calculation_1627573247025157] }' />
            </column>
