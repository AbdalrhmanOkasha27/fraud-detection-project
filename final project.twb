    <worksheet name='Fraud Control Chart'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontcolor='#ffffff' fontname='Cascadia Code' fontsize='16'>Segment Fraud Rate vs. Statistical Bounds</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Fact_Transactions+' name='federated.1mctkil1o0nn8q1gwws6q0vcfvh3' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Select Dimension' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Merchant Category&quot;'>
              <calculation class='tableau' formula='&quot;Merchant Category&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1mctkil1o0nn8q1gwws6q0vcfvh3'>
            <column caption='Total Transactions' datatype='integer' name='[Calculation_1627573243392000]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT([Customer_ID])' />
            </column>
            <column caption='Total Fraud Count' datatype='integer' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1627573246181379]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Is_Fraud] = 1 THEN 1 ELSE 0 END)' />
            </column>
            <column caption='Fraud Rate %' datatype='real' default-format='p0.00%' name='[Calculation_1627573247025157]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1627573246181379] / [Calculation_1627573243392000]' />
            </column>
            <column caption='Baseline Fraud Rate' datatype='real' default-format='p0.00%' name='[Calculation_1627573249499145]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED : [Calculation_1627573247025157] }' />
            </column>
            <column caption='Segment Sample Size' datatype='integer' name='[Calculation_1627573249765386]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT([__tableau_internal_object_id__].[Fact_Transactions.csv_F15F1C9571E14AEF8A4DCE8BBBADD611])' />
            </column>
            <column caption='Segment Fraud Rate' datatype='real' default-format='p0.00%' name='[Calculation_1627573250211851]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1627573246181379] / [Calculation_1627573249765386]' />
            </column>
            <column caption='Wilson Z Value' datatype='real' name='[Calculation_1627573250383884]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1.96' />
            </column>
            <column caption='Wilson Center' datatype='real' name='[Calculation_1627573250523149]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_1627573250211851] + (([Calculation_1627573250383884] * [Calculation_1627573250383884]) / (2 * [Calculation_1627573249765386]))) / (1 + (([Calculation_1627573250383884] * [Calculation_1627573250383884]) / [Calculation_1627573249765386]))' />
            </column>
            <column caption='Wilson Margin' datatype='real' name='[Calculation_1627573250670606]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_1627573250383884] * SQRT((([Calculation_1627573250211851] * (1 - [Calculation_1627573250211851])) / [Calculation_1627573249765386]) + (([Calculation_1627573250383884] * [Calculation_1627573250383884]) / (4 * [Calculation_1627573249765386] * [Calculation_1627573249765386])))) / (1 + (([Calculation_1627573250383884] * [Calculation_1627573250383884]) / [Calculation_1627573249765386]))' />
            </column>
            <column caption='Upper Bound' datatype='real' default-format='p0.00%' name='[Calculation_1627573250826255]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1627573250523149] + [Calculation_1627573250670606]' />
            </column>
            <column caption='Lower Bound' datatype='real' default-format='p0.00%' name='[Calculation_1627573250981904]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MAX(0, [Calculation_1627573250523149] - [Calculation_1627573250670606])' />
            </column>
            <column caption='Is Segment Significant vs Baseline' datatype='string' name='[Calculation_1627573251186705]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ATTR([Calculation_1627573249499145]) &lt; [Calculation_1627573250981904] OR ATTR([Calculation_1627573249499145]) &gt; [Calculation_1627573250826255]&#13;&#10;THEN &quot;Significant Deviation&quot;&#13;&#10;ELSE &quot;Within Normal Range&quot;&#13;&#10;END' />
            </column>
            <column caption='Dynamic Dimension' datatype='string' name='[Calculation_1627573271441434]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &quot;Merchant Category&quot; THEN [Merchant_Category]&#13;&#10;WHEN &quot;Device Type&quot; THEN [Device_Type]&#13;&#10;WHEN &quot;Transaction Type&quot; THEN [Transaction_Type]&#13;&#10;END' />
            </column>
            <column caption='Customer ID' datatype='string' name='[Customer_ID]' role='dimension' type='nominal' />
            <column datatype='datetime' name='[Date]' role='dimension' type='ordinal' />
            <column caption='Device Type' datatype='string' name='[Device_Type]' role='dimension' type='nominal' />
            <column datatype='string' name='[Gender]' role='dimension' type='nominal' />
            <column caption='Is Fraud' datatype='integer' name='[Is_Fraud]' role='measure' type='quantitative' />
            <column caption='Merchant Category' datatype='string' name='[Merchant_Category]' role='dimension' type='nominal' />
            <column caption='State (Dim Geography.csv)' datatype='string' name='[State (Dim_Geography.csv)]' role='dimension' semantic-role='[State].[Name]' type='nominal' />
