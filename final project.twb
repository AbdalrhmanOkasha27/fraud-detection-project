      </column>
      <column caption='Segment Fraud Rate' datatype='real' default-format='p0.00%' name='[Calculation_1627573250211851]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1627573246181379] / [Calculation_1627573249765386]' />
      </column>
      <column caption='Wilson Z Value' datatype='real' name='[Calculation_1627573250383884]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1.96' />
      </column>
      <column caption='Wilson Center' datatype='real' name='[Calculation_1627573250523149]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_1627573250211851] + (([Calculation_1627573250383884] * [Calculation_1627573250383884]) / (2 * [Calculation_1627573249765386]))) / (1 + (([Calculation_1627573250383884] * [Calculation_1627573250383884]) / [Calculation_1627573249765386]))' />
      </column>
      <column caption='Wilson Margin' datatype='real' name='[Calculation_1627573250670606]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_1627573250383884] * SQRT((([Calculation_1627573250211851] * (1 - [Calculation_1627573250211851])) / [Calculation_1627573249765386]) + (([Calculation_1627573250383884] * [Calculation_1627573250383884]) / (4 * [Calculation_1627573249765386] * [Calculation_1627573249765386])))) / (1 + (([Calculation_1627573250383884] * [Calculation_1627573250383884]) / [Calculation_1627573249765386]))' />
      </column>
      <column caption='Upper Bound' datatype='real' default-format='p0.00%' name='[Calculation_1627573250826255]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1627573250523149] + [Calculation_1627573250670606]' />
      </column>
      <column caption='Lower Bound' datatype='real' default-format='p0.00%' name='[Calculation_1627573250981904]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX(0, [Calculation_1627573250523149] - [Calculation_1627573250670606])' />
      </column>
      <column caption='Is Segment Significant vs Baseline' datatype='string' name='[Calculation_1627573251186705]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF ATTR([Calculation_1627573249499145]) &lt; [Calculation_1627573250981904] OR ATTR([Calculation_1627573249499145]) &gt; [Calculation_1627573250826255]&#13;&#10;THEN &quot;Significant Deviation&quot;&#13;&#10;ELSE &quot;Within Normal Range&quot;&#13;&#10;END' />
      </column>
      <column caption='Daily Transaction Count' datatype='integer' name='[Calculation_1627573252755474]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Date] : [Calculation_1627573243392000] }' />
      </column>
      <column caption='Daily Fraud Rate' datatype='real' default-format='p0.00%' name='[Calculation_1627573252870163]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Date] : [Calculation_1627573247025157] }' />
      </column>
      <column caption='7-Day Moving Avg Transaction Volume' datatype='real' default-format='*₹ #,##,##0;₹ -#,##,##0' name='[Calculation_1627573253173268]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_AVG([Calculation_1627573244006401], -6, 0)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Day-over-Day Volume Change %' datatype='real' default-format='p0.00%' name='[Calculation_1627573253386261]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_1627573244006401] - LOOKUP([Calculation_1627573244006401], -1)) / LOOKUP([Calculation_1627573244006401], -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Dynamic Dimension' datatype='string' name='[Calculation_1627573271441434]' role='dimension' type='nominal'>
